[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.3
reloadable = true

[libraries]
# Headless / editor may select linux.x86_64 or linux.{debug,release}.x86_64.
linux.x86_64 = "res://bin/libpe_godot.so"
linux.debug.x86_64 = "res://bin/libpe_godot.so"
linux.release.x86_64 = "res://bin/libpe_godot.so"
macos.universal = "res://bin/libpe_godot.dylib"
macos.debug = "res://bin/libpe_godot.dylib"
macos.release = "res://bin/libpe_godot.dylib"
windows.x86_64 = "res://bin/pe_godot.dll"
windows.debug.x86_64 = "res://bin/pe_godot.dll"
windows.release.x86_64 = "res://bin/pe_godot.dll"
