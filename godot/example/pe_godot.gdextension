[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.3
reloadable = true

[libraries]
linux.debug.x86_64 = "res://../../target/debug/libpe_godot.so"
linux.release.x86_64 = "res://../../target/release/libpe_godot.so"
macos.debug = "res://../../target/debug/libpe_godot.dylib"
macos.release = "res://../../target/release/libpe_godot.dylib"
windows.debug.x86_64 = "res://../../target/debug/pe_godot.dll"
windows.release.x86_64 = "res://../../target/release/pe_godot.dll"
