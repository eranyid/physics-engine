class SoftWorld:
    """XPBD soft-body world."""

    def __init__(self) -> None: ...
    @staticmethod
    def rope(
        a: ArrayLike,
        b: ArrayLike,
        segments: int = ...,
        mass: float = ...,
        compliance: float = ...,
        pin_ends: bool = ...,
    ) -> SoftWorld: ...
    @staticmethod
    def cloth(
        origin: ArrayLike,
        nx: int = ...,
        ny: int = ...,
        dx: float = ...,
        dy: float = ...,
        mass: float = ...,
        stretch_compliance: float = ...,
        bend_compliance: float = ...,
        pin_corners: bool = ...,
    ) -> SoftWorld: ...
    @staticmethod
    def soft_cube(
        origin: ArrayLike,
        size: float = ...,
        divisions: int = ...,
        material: str = ...,
        neo_hookean: bool = ...,
    ) -> SoftWorld: ...
    @property
    def n(self) -> int: ...
    @property
    def t(self) -> float: ...
    def x(self) -> NDArray[np.float64]: ...
    def v(self) -> NDArray[np.float64]: ...
    def pack(self) -> NDArray[np.float64]: ...
    def kinetic_energy(self) -> float: ...
    def total_energy(self) -> float: ...
    def set_params(
        self,
        substeps: Optional[int] = ...,
        iterations: Optional[int] = ...,
        damping: Optional[float] = ...,
        gravity: Optional[ArrayLike] = ...,
    ) -> None: ...
    def add_ground_plane(
        self,
        normal: ArrayLike,
        offset: float = ...,
        friction: float = ...,
        restitution: float = ...,
    ) -> None: ...
    def step(self, dt: float) -> None: ...
    def run(self, t_end: float, dt: float) -> None: ...

